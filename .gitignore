# Track only these folders:
#   audit/  auto_run_bugbash/  caseGenerator/  evaluation/  gen_rubric/  generate/
# Ignore everything else at the root level.

# Ignore all root files/dirs by default
/*

# Un-ignore the folders we want to track
!/audit/
!/auto_run_bugbash/
!/caseGenerator/
!/evaluation/
!/gen_rubric/
!/generate/
!/bug_bash/
!/auth/
# Also keep these git meta files
!.gitignore
!.gitattributes

# Common build artifacts (safety net inside tracked folders)
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
.tox/
*.tmp
node_modules/
